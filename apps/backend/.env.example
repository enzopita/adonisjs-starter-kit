# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=starter
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# The frontend's own origin, for links sent in emails (invitations)
FRONTEND_URL=http://localhost:5173
# Sent as the x-monitoring-secret header to GET /health/ready
MONITORING_SECRET=local-monitoring-secret
# Comma-separated origins allowed outside development, e.g. https://app.example.com
CORS_ORIGIN=
# Days an audit event is kept before the daily prune deletes it (default 365)
AUDIT_RETENTION_DAYS=365

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=${APP_NAME}

# Mail (mailpit in compose.yaml, UI on MAILPIT_PORT)
MAIL_MAILER=smtp
MAIL_FROM_NAME=${APP_NAME}
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_PORT=8025

# Drive (rustfs in compose.yaml, console at :RUSTFS_CONSOLE_PORT/rustfs/console)
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_REGION=us-east-1
S3_BUCKET=${APP_NAME}
S3_PORT=9000
S3_ENDPOINT=http://127.0.0.1:${S3_PORT}
S3_FORCE_PATH_STYLE=true
RUSTFS_CONSOLE_PORT=9001

# Session
SESSION_DRIVER=cookie

# Redis (redis in compose.yaml)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue (jobs run in a separate `node ace queue:work` process)
QUEUE_DRIVER=redis
