{
  "name": "@monorepo/backend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#app/*": "./app/*.js",
    "#core/*": "./app/core/*.js",
    "#auth/*": "./app/auth/*.js",
    "#users/*": "./app/users/*.js",
    "#attachments/*": "./app/attachments/*.js",
    "#tenancy/*": "./app/tenancy/*.js",
    "#access/*": "./app/access/*.js",
    "#audit/*": "./app/audit/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "dev:worker": "node --watch ace queue:work",
    "codegen": "node ace codegen",
    "test": "node ace test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "catalog:",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "catalog:",
    "@adonisjs/i18n": "catalog:",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "catalog:",
    "@adonisjs/queue": "catalog:",
    "@adonisjs/redis": "catalog:",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "catalog:",
    "@vinejs/vine": "^4.4.0",
    "edge.js": "catalog:",
    "luxon": "^3.7.2",
    "mjml": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/mjml": "catalog:",
    "@types/node": "catalog:",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/*/controllers/**/*.ts",
      "./app/*/middleware/*.ts"
    ]
  }
}
