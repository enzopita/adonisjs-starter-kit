DB_DATABASE=starter_test
QUEUE_DRIVER=sync
FRONTEND_URL=http://localhost:5173
LIMITER_STORE=memory
# The functional suite calls 127.0.0.1: bound to `localhost`, the server can take ::1 where
# localhost resolves to IPv6 first (Debian containers, some distros) and refuse every request.
HOST=127.0.0.1
