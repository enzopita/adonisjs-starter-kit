{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "docker compose up -d --wait && pnpm --filter @monorepo/backend exec node ace queue:migrate && turbo dev dev:worker",
    "codegen": "turbo codegen",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck && tsc -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test:e2e": "e2e run",
    "test:e2e:ci": "e2e run --strict-cache",
    "docs:pull": "sh scripts/pull-docs.sh",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@e2e-dev/web": "^0.15.3",
    "@julr/tooling-configs": "^6.4.0",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@oxlint/plugins": "1.90.0",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "ai": "^7.0.156",
    "e2e": "^0.21.3",
    "lefthook": "^2.2.2",
    "otpauth": "catalog:",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "zod": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
